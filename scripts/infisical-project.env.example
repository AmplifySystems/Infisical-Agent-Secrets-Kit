# Copy to scripts/infisical-project.env.
# This file should contain non-secret settings only.
# Add scripts/infisical-project.env to .gitignore.

INFISICAL_BIN="infisical"
INFISICAL_PROJECT_ID="replace-with-project-id"
INFISICAL_ENV="dev"
INFISICAL_SECRET_PATH="/mcp"

# Optional. Use for EU Cloud or self-hosted Infisical.
# US Cloud default is usually fine when omitted.
# INFISICAL_API_URL="https://app.infisical.com"
# INFISICAL_API_URL="https://eu.infisical.com"

